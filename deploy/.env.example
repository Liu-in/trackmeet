# ============================================================================
# TrackMeet 部署环境变量模板
# ----------------------------------------------------------------------------
# 用法：复制为 .env 后按需修改（.env 与 docker-compose.yml 同目录： deploy/.env）
#   Linux/macOS : cp .env.example .env
#   Windows     : Copy-Item .env.example .env
# 注意：
#   1) 生产环境务必修改 MYSQL_ROOT_PASSWORD / DB_PASSWORD / JWT_SECRET，
#      并把 DEFAULT_ACCOUNT_PASSWORD 改成强口令或首登后立即改密；
#   2) .env 不要提交到版本库（已在 .gitignore 中排除）；
#   3) 变量值中不要出现空格；含特殊字符时用单引号包裹。
# ============================================================================

# ---- 时区 / 语言 ----
# 三个容器的 TZ；影响日志时间与 MySQL 会话时区展示
TZ=Asia/Shanghai

# ---- MySQL ----
# root 口令（仅容器内初始化与运维使用，勿对外暴露）
MYSQL_ROOT_PASSWORD=root123456
# 业务库名（与 sql/*.sql 中的库名保持一致，改库名需同步改 sql 脚本）
DB_NAME=trackmeet
# 业务账号（后端连接使用，由 MySQL 官方镜像首次启动时自动创建并授权）
DB_USERNAME=trackmeet
DB_PASSWORD=trackmeet123
# 宿主机映射端口（如本机已有 MySQL 请改成 3307）
MYSQL_PORT=3306
# 运维脚本操作的容器名（一般无需修改）
MYSQL_CONTAINER=trackmeet-mysql

# ---- 后端（Spring Boot 3，容器内 8080）----
# 后端宿主机映射端口
BACKEND_PORT=8080
# 激活的 Spring profile（生产固定 prod；本地调试可改 dev，但 dev 默认连 localhost:3306）
SPRING_PROFILES_ACTIVE=prod
# JWT 签名密钥：长度必须 >= 32 字节，生产环境务必修改
# 生成示例： openssl rand -base64 48
JWT_SECRET=trackmeet-jwt-secret-key-please-change-in-production-2024
# 允许的跨域来源（英文逗号分隔；同源部署保持默认即可）
CORS_ORIGINS=http://localhost,http://127.0.0.1
# 日志级别：trace/debug/info/warn/error，影响 root 与 com.trackmeet
LOG_LEVEL=info
# 首登默认口令：后端 DefaultAccountInitializer 用它初始化占位口令账号（admin/scheduler/referee/leader1）
DEFAULT_ACCOUNT_PASSWORD=Admin@123

# ---- 前端（Nginx 静态站点 + /api 反代）----
# 前端访问端口（浏览器打开 http://<服务器IP>:该端口）
WEB_PORT=80
# 前端监听地址：0.0.0.0 表示所有网卡；只想本机访问可改成 127.0.0.1
WEB_BIND=0.0.0.0

# ---- 备份 / 运维 ----
# 备份输出目录（相对路径基于 deploy/ 目录；也可写绝对路径）
BACKUP_DIR=backups
# 备份保留份数（按修改时间保留最新 N 份，被 backup 脚本读取；命令行 --keep 可覆盖）
BACKUP_KEEP=30

# ---- 可选排障工具（默认不启动，需 --profile tools）----
# Adminer 端口（仅绑定 127.0.0.1）；启动： docker compose --profile tools up -d adminer
ADMINER_PORT=8082
